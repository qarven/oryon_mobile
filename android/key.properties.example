# Android Release Signing Configuration
# Copy this file as 'key.properties' and fill in your values
# DO NOT commit key.properties to version control

storePassword=your_keystore_password
keyPassword=your_key_password
keyAlias=your_key_alias
storeFile=/path/to/your/keystore.jks

# Example:
# storePassword=MySecurePassword123
# keyPassword=MyKeyPassword456
# keyAlias=oryon_release_key
# storeFile=/Users/<name>/Documents/keystores/oryon_release.jks
